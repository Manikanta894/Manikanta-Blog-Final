# Database driver: supabase (production/default) | demo (local only, no database)
DB_DRIVER=supabase

# Supabase (required when DB_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_MEDIA_BUCKET=media
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Site URL used for absolute links (RSS, OG, newsletter)
NEXT_PUBLIC_SITE_URL=https://insights.manikantar.in
NEXT_PUBLIC_BASE_URL=https://insights.manikantar.in

# Admin bootstrap password (used once to create the admin user; remove after first login)
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-run

# Session signing secret (required; long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# TOTP encryption key (required for 2FA; any strong passphrase)
TOTP_ENCRYPTION_KEY=change-me-to-a-long-random-passphrase

# API secret for external publishing (social media app, n8n, etc.)
# ARTICLES_API_SECRET=your-random-secret

# Cron secret (Vercel Cron / automation callers)
# CRON_SECRET=your-long-random-cron-secret

# Hashnode auto-publish
# HASHNODE_PAT=your-hashnode-personal-access-token
# HASHNODE_PUBLICATION_ID=your-publication-id

# AI generation (Groq / OpenRouter)
# GROQ_API_KEY=your-groq-key
# OPENROUTER_API_KEY=your-openrouter-key

# LinkedIn auto-posting
# LINKEDIN_TOKEN=your-linkedin-access-token
# LINKEDIN_ACTOR=urn:li:person:your-id

# Zoho Mail (for newsletter sending)
# ZOHO_EMAIL=your@email.com
# ZOHO_APP_PASSWORD=your-zoho-app-password

# Cloudflare R2 media storage (server-side only; never expose to client)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-bucket-name
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_BASE_URL=https://your-public-r2-domain (optional)