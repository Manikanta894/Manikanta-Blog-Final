# Database driver: demo | mongo | supabase
DB_DRIVER=demo

# MongoDB (DB_DRIVER=mongo)
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=manii_journal

# Supabase (DB_DRIVER=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials (required for /admin login)
# ADMIN_PASSWORD=your-admin-password
# ADMIN_SESSION_SECRET=your-long-random-session-secret

# API secret for external publishing (social media app, n8n, etc.)
# ARTICLES_API_SECRET=your-random-secret

# Hashnode auto-publish
# HASHNODE_PAT=your-hashnode-personal-access-token
# HASHNODE_PUBLICATION_ID=your-publication-id

# AI generation (Groq / OpenRouter)
# GROQ_API_KEY=your-groq-key
# OPENROUTER_API_KEY=your-openrouter-key

# LinkedIn auto-posting
# LINKEDIN_TOKEN=your-linkedin-access-token
# LINKEDIN_ACTOR=urn:li:person:your-id

# Zoho Mail (for newsletter sending)
# ZOHO_EMAIL=your@email.com
# ZOHO_APP_PASSWORD=your-zoho-app-password
